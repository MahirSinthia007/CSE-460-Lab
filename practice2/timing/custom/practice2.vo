`timescale 1 ps/ 1 ps

module practice2 (
	x1,
	x2,
	x3,
	x4,
	f);
input 	x1;
input 	x2;
input 	x3;
input 	x4;
output 	f;

wire gnd = 1'b0;
wire vcc = 1'b1;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
// synopsys translate_off
initial $sdf_annotate("practice2_v.sdo");
// synopsys translate_on

wire \x4~dataout ;
wire \x1~dataout ;
wire \x3~dataout ;
wire \x2~dataout ;
wire \WideOr0~13_combout ;


// atom is at PIN_126
flex10ke_io \x4~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\x4~dataout ),
	.padio(x4));
// synopsys translate_off
defparam \x4~I .feedback_mode = "from_pin";
defparam \x4~I .operation_mode = "input";
defparam \x4~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at PIN_124
flex10ke_io \x1~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\x1~dataout ),
	.padio(x1));
// synopsys translate_off
defparam \x1~I .feedback_mode = "from_pin";
defparam \x1~I .operation_mode = "input";
defparam \x1~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at PIN_54
flex10ke_io \x3~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\x3~dataout ),
	.padio(x3));
// synopsys translate_off
defparam \x3~I .feedback_mode = "from_pin";
defparam \x3~I .operation_mode = "input";
defparam \x3~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at PIN_56
flex10ke_io \x2~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\x2~dataout ),
	.padio(x2));
// synopsys translate_off
defparam \x2~I .feedback_mode = "from_pin";
defparam \x2~I .operation_mode = "input";
defparam \x2~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at LC1_C27
flex10ke_lcell \WideOr0~13 (
// Equation(s):
// \WideOr0~13_combout  = \x3~dataout  & (\x1~dataout  # \x4~dataout  & \x2~dataout ) # !\x3~dataout  & (\x4~dataout  # !\x2~dataout )

	.dataa(\x4~dataout ),
	.datab(\x1~dataout ),
	.datac(\x3~dataout ),
	.datad(\x2~dataout ),
	.aclr(gnd),
	.aload(gnd),
	.clk(gnd),
	.cin(gnd),
	.cascin(vcc),
	.devclrn(devclrn),
	.devpor(devpor),
	.combout(\WideOr0~13_combout ),
	.regout(),
	.cout(),
	.cascout());
// synopsys translate_off
defparam \WideOr0~13 .clock_enable_mode = "false";
defparam \WideOr0~13 .lut_mask = "eacf";
defparam \WideOr0~13 .operation_mode = "normal";
defparam \WideOr0~13 .output_mode = "comb_only";
defparam \WideOr0~13 .packed_mode = "false";
// synopsys translate_on

// atom is at PIN_46
flex10ke_io \f~I (
	.datain(\WideOr0~13_combout ),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(vcc),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(),
	.padio(f));
// synopsys translate_off
defparam \f~I .feedback_mode = "none";
defparam \f~I .operation_mode = "output";
defparam \f~I .reg_source_mode = "none";
// synopsys translate_on

endmodule
