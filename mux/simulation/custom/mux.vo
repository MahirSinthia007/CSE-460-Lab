// VENDOR "Altera"
// PROGRAM "Quartus II"
// VERSION "Version 8.1 Build 163 10/28/2008 SJ Web Edition"

// DATE "10/13/2026 13:20:30"

// 
// Device: Altera EPF10K30ETC144-1 Package TQFP144
// 

// 
// This Verilog file should be used for Custom Verilog HDL only
// 

`timescale 1 ps/ 1 ps

module mux (
	f,
	i0,
	i1,
	s0);
output 	f;
input 	i0;
input 	i1;
input 	s0;

wire gnd = 1'b0;
wire vcc = 1'b1;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
// synopsys translate_off
initial $sdf_annotate("mux_v.sdo");
// synopsys translate_on

wire \i1~dataout ;
wire \i0~dataout ;
wire \s0~dataout ;
wire \f~5_combout ;


// atom is at PIN_126
flex10ke_io \i1~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\i1~dataout ),
	.padio(i1));
// synopsys translate_off
defparam \i1~I .feedback_mode = "from_pin";
defparam \i1~I .operation_mode = "input";
defparam \i1~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at PIN_124
flex10ke_io \i0~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\i0~dataout ),
	.padio(i0));
// synopsys translate_off
defparam \i0~I .feedback_mode = "from_pin";
defparam \i0~I .operation_mode = "input";
defparam \i0~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at PIN_54
flex10ke_io \s0~I (
	.datain(gnd),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(\s0~dataout ),
	.padio(s0));
// synopsys translate_off
defparam \s0~I .feedback_mode = "from_pin";
defparam \s0~I .operation_mode = "input";
defparam \s0~I .reg_source_mode = "none";
// synopsys translate_on

// atom is at LC5_C19
flex10ke_lcell \f~5 (
// Equation(s):
// \f~5_combout  = \s0~dataout  & \i1~dataout  # !\s0~dataout  & (\i0~dataout )

	.dataa(vcc),
	.datab(\i1~dataout ),
	.datac(\i0~dataout ),
	.datad(\s0~dataout ),
	.aclr(gnd),
	.aload(gnd),
	.clk(gnd),
	.cin(gnd),
	.cascin(vcc),
	.devclrn(devclrn),
	.devpor(devpor),
	.combout(\f~5_combout ),
	.regout(),
	.cout(),
	.cascout());
// synopsys translate_off
defparam \f~5 .clock_enable_mode = "false";
defparam \f~5 .lut_mask = "ccf0";
defparam \f~5 .operation_mode = "normal";
defparam \f~5 .output_mode = "comb_only";
defparam \f~5 .packed_mode = "false";
// synopsys translate_on

// atom is at PIN_51
flex10ke_io \f~I (
	.datain(\f~5_combout ),
	.clk(gnd),
	.ena(vcc),
	.aclr(gnd),
	.oe(vcc),
	.devclrn(devclrn),
	.devpor(devpor),
	.devoe(devoe),
	.dataout(),
	.padio(f));
// synopsys translate_off
defparam \f~I .feedback_mode = "none";
defparam \f~I .operation_mode = "output";
defparam \f~I .reg_source_mode = "none";
// synopsys translate_on

endmodule
